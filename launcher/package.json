{
  "name": "modeldock",
  "version": "0.1.1",
  "private": true,
  "description": "ModelDock 桌面應用（Electron，內含瀏覽器，多模型統一管理）",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "typecheck": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/automation.cjs",
    "package:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "dev.modeldock.app",
    "productName": "ModelDock",
    "artifactName": "ModelDock-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["electron/**", "renderer/**", "build/**", "package.json"],
    "extraFiles": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../run_server.py",
        "to": "run_server.py"
      },
      {
        "from": "../mcp_server.py",
        "to": "mcp_server.py"
      },
      {
        "from": "../desktop_app.py",
        "to": "desktop_app.py"
      },
      {
        "from": "../setup_antigravity.py",
        "to": "setup_antigravity.py"
      },
      {
        "from": "../gemini_cookies.example.json",
        "to": "gemini_cookies.example.json"
      },
      {
        "from": "../deepseek_token.example.json",
        "to": "deepseek_token.example.json"
      },
      {
        "from": "../mcp_configs",
        "to": "mcp_configs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "build/icon",
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ModelDock",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
