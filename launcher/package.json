{
  "name": "modeldock",
  "version": "0.1.0",
  "private": true,
  "description": "ModelDock 桌面應用（Electron，內含瀏覽器，多模型統一管理）",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "typecheck": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/automation.cjs",
    "package:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "dev.modeldock.app",
    "productName": "ModelDock",
    "artifactName": "ModelDock-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["electron/**", "renderer/**", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
